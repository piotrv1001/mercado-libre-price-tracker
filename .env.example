# https://console.apify.com/settings/integrations
APIFY_TOKEN=your_apify_token_here

# Matches docker-compose.yml
DATABASE_URL=postgres://meli:meli@localhost:5432/meli

# Mercado Libre site: MLA Argentina, MLB Brazil, MLM Mexico, MLC Chile, MCO Colombia, MLU Uruguay, MPE Peru
SITE_ID=MLA
# Listings per search and run (results come in relevance order)
MAX_ITEMS=50
# new, used or any
CONDITION=any
